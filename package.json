{
  "name": "dsh-stock-bbar",
  "version": "1.0.0",
  "description": "Live prices for a comma-separated list of A-share, Beijing, Hong Kong, or index codes under the DSH message composer, with red-up green-down colouring and session percentages.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "stock",
    "quote",
    "ticker",
    "index",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjrqz777/dsh-stock-bbar.git"
  },
  "homepage": "https://github.com/yjrqz777/dsh-stock-bbar#readme",
  "bugs": {
    "url": "https://github.com/yjrqz777/dsh-stock-bbar/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 || >=0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.5": "compatible"
      }
    }
  }
}
